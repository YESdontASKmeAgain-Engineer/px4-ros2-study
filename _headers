/manifest.json
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
/index.html
  Cache-Control: no-cache
/app.apk
  Content-Type: application/vnd.android.package-archive
  Cache-Control: no-cache
/content/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
